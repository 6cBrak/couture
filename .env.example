# Copier ce fichier en .env et remplir les valeurs

APP_DOMAIN=caisse.mondomaine.com

# Nom unique de l'instance (noms des conteneurs + routeur Traefik).
# Doit être différent pour chaque client sur le même VPS.
INSTANCE=couture

DB_NAME=couture_db
DB_USER=couture_user
DB_PASS=mot_de_passe_fort_ici
DB_ROOT_PASS=root_password_fort_ici
